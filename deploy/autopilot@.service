# systemd unit: one instance per project.
#   sudo cp deploy/autopilot@.service /etc/systemd/system/
#   sudo systemctl enable --now autopilot@intelwatch      # project at /srv/projects/intelwatch
# Secrets/config: /etc/autopilot/<name>.env  (ANTHROPIC_API_KEY or ANTHROPIC_BASE_URL for LiteLLM,
#                 AUTOPILOT_TG_TOKEN, AUTOPILOT_TG_CHAT, ...)
[Unit]
Description=Autopilot autonomous build for %i
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=autopilot
WorkingDirectory=/srv/projects/%i
EnvironmentFile=-/etc/autopilot/%i.env
Environment=IS_SANDBOX=1
ExecStart=/usr/local/bin/autopilot run
# a finished run exits 0 and stays down; crashes restart and resume from the state DB
Restart=on-failure
RestartSec=120
TimeoutStopSec=60
KillSignal=SIGINT
StandardOutput=append:/var/log/autopilot/%i.log
StandardError=append:/var/log/autopilot/%i.log

[Install]
WantedBy=multi-user.target
